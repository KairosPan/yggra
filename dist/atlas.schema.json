{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-evolution-atlas-pan.pan5998022.chatgpt.site/atlas.schema.json",
  "title": "Yggra dataset, schema 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "dataset_version": {
      "type": "string"
    },
    "language": {
      "const": "en"
    },
    "updated_at": {
      "type": "string",
      "format": "date"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "coverage": {
      "type": "string"
    },
    "annotation_kind": {
      "type": "string"
    },
    "relationship_semantics": {
      "type": "string"
    },
    "year_basis": {
      "type": "string"
    },
    "course_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed_at": {
            "type": "string",
            "format": "date"
          },
          "reading_status": {
            "type": "string"
          },
          "use": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "accessed_at",
          "reading_status",
          "use"
        ]
      }
    },
    "cross_cutting_facets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "course_lectures": {
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "application": {
            "type": "string"
          }
        },
        "required": [
          "title",
          "course_lectures",
          "application"
        ]
      }
    },
    "question_filter": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "included_statuses": {
          "type": "array",
          "items": {
            "enum": [
              "tested",
              "mechanism",
              "unknown",
              "outside"
            ]
          }
        },
        "meaning": {
          "type": "string"
        }
      },
      "required": [
        "included_statuses",
        "meaning"
      ]
    },
    "status_definitions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tested": {
          "type": "string"
        },
        "mechanism": {
          "type": "string"
        },
        "unknown": {
          "type": "string"
        },
        "outside": {
          "type": "string"
        }
      },
      "required": [
        "tested",
        "mechanism",
        "unknown",
        "outside"
      ]
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "q1",
              "q2",
              "q3"
            ]
          },
          "short": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "criterion": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "short",
          "title",
          "description",
          "criterion"
        ]
      }
    },
    "branches": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "papers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pathway": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "course_source_id": {
                "type": "string"
              },
              "course_lectures": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1
                }
              },
              "stages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id",
                    "title"
                  ]
                }
              },
              "stage_order_semantics": {
                "type": "string"
              },
              "suggested_evaluation": {
                "type": "string"
              },
              "improvement_hypothesis": {
                "type": "string"
              },
              "related_method_ids": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "reading_status": {
                "type": "string"
              },
              "readings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "paper_id": {
                      "type": "string"
                    },
                    "role": {
                      "enum": [
                        "direct",
                        "bridge"
                      ]
                    }
                  },
                  "required": [
                    "paper_id",
                    "role"
                  ]
                }
              }
            },
            "required": [
              "course_source_id",
              "course_lectures",
              "stages",
              "stage_order_semantics",
              "suggested_evaluation",
              "improvement_hypothesis",
              "related_method_ids",
              "reading_status",
              "readings"
            ]
          }
        },
        "required": [
          "id",
          "parent_id",
          "title",
          "code",
          "summary",
          "tags",
          "papers"
        ]
      }
    },
    "papers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "year": {
            "type": "integer",
            "minimum": 1900
          },
          "branch": {
            "type": "string"
          },
          "branch_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "paper": {
            "type": "string",
            "format": "uri"
          },
          "source": {
            "type": "string",
            "format": "uri"
          },
          "mechanism": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "q1": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "tested",
                      "mechanism",
                      "unknown",
                      "outside"
                    ]
                  },
                  "note": {
                    "type": "string"
                  },
                  "source_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "source_locator": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "status",
                  "note",
                  "source_url",
                  "source_locator"
                ]
              },
              "q2": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "tested",
                      "mechanism",
                      "unknown",
                      "outside"
                    ]
                  },
                  "note": {
                    "type": "string"
                  },
                  "source_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "source_locator": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "status",
                  "note",
                  "source_url",
                  "source_locator"
                ]
              },
              "q3": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "status": {
                    "enum": [
                      "tested",
                      "mechanism",
                      "unknown",
                      "outside"
                    ]
                  },
                  "note": {
                    "type": "string"
                  },
                  "source_url": {
                    "type": "string",
                    "format": "uri"
                  },
                  "source_locator": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "status",
                  "note",
                  "source_url",
                  "source_locator"
                ]
              }
            },
            "required": [
              "q1",
              "q2",
              "q3"
            ]
          },
          "limitation": {
            "type": "string"
          },
          "course_reading": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "course_source_id": {
                "type": "string"
              },
              "lecture": {
                "type": "integer"
              },
              "assignment": {
                "enum": [
                  "assigned",
                  "optional"
                ]
              }
            },
            "required": [
              "course_source_id",
              "lecture",
              "assignment"
            ]
          }
        },
        "required": [
          "id",
          "name",
          "title",
          "year",
          "branch",
          "branch_ids",
          "paper",
          "mechanism",
          "targets",
          "evidence"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "dataset_version",
    "language",
    "updated_at",
    "title",
    "description",
    "coverage",
    "annotation_kind",
    "relationship_semantics",
    "year_basis",
    "course_sources",
    "cross_cutting_facets",
    "question_filter",
    "status_definitions",
    "questions",
    "branches",
    "papers"
  ]
}
